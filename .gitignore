# orchestrator/ and console/ are each their own real git repository —
# deliberately not nested here as submodules; this repo versions the
# coordination layer (COORDINATION.md, STAGE*.md, docs/, scripts/) only.
/orchestrator/
/console/

# Per-session git worktrees (day2/scripts/new-worktree.sh) — ephemeral,
# created and removed per workstream, never meant to be committed.
/worktrees/

# Local tool/cache state, not project content.
/.claude/
/.wrangler/
.DS_Store
